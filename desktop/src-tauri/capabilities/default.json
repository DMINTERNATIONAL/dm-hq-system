{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "웹앱(GitHub Pages)이 알림 · 아이콘 숫자 · 외부 링크 열기를 쓸 수 있게",
  "windows": ["main"],
  "remote": { "urls": ["https://dminternational.github.io/*", "http://localhost:8012/*"] },
  "permissions": [
    "core:default",
    "core:window:allow-set-badge-count",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "notification:default",
    "opener:default"
  ]
}
